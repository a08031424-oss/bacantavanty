document.addEventListener("DOMContentLoaded",function(){var e=[].slice.call(document.querySelectorAll("img.lazy"));if("IntersectionObserver"in window){let t=new IntersectionObserver(function(e,s){e.forEach(function(e){if(e.isIntersecting){let s=e.target;s.src=s.dataset.src;if(s.dataset.srcset){s.srcset=s.dataset.srcset}if(s.dataset.sizes){s.sizes=s.dataset.sizes}s.classList.remove("lazy");t.unobserve(s)}})});e.forEach(function(e){t.observe(e)})}else{let t=false;const s=function(){if(false===t){t=true;setTimeout(function(){e.forEach(function(t){if(t.getBoundingClientRect().top<=window.innerHeight&&0<=t.getBoundingClientRect().bottom&&"none"!==getComputedStyle(t).display){t.src=t.dataset.src;if(t.dataset.srcset){t.srcset=t.dataset.srcset}if(t.dataset.sizes){t.sizes=t.dataset.sizes}t.classList.remove("lazy");e=e.filter(function(e){return e!==t});if(0===e.length){document.removeEventListener("scroll",s);window.removeEventListener("resize",s);window.removeEventListener("orientationchange",s)}}});t=false},200)}};document.addEventListener("scroll",s);window.addEventListener("resize",s);window.addEventListener("orientationchange",s)}});